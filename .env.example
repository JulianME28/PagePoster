OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Local monthly limits (UTC month). Unknown paid requests retain a reservation.
PAGEPOSTER_AI_MONTHLY_USD=10
PAGEPOSTER_AI_MONTHLY_TOKENS=2000000
